# Reserved for the planned hosted multi-user backend. These values are not used
# by the current local-first desktop runtime and must never ship in the client.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
BACKEND_TOKEN_ENCRYPTION_KEY=
APP_NAME=KMS DTF ERP API
APP_ENV=development
DEVELOPER_MODE=false
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=kms_erp_session
CSRF_COOKIE_NAME=kms_erp_csrf
SESSION_LIFETIME_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
STORAGE_PROVIDER=local
STORAGE_CACHE_DIRECTORY=local_data/web_storage_cache
LOCAL_OBJECT_DIRECTORY=local_data/web_object_store
BACKBLAZE_ENDPOINT_URL=
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET=
MAXIMUM_UPLOAD_MB=100
